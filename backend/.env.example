# Copy file này thành .env và điền giá trị thực

# Port (Railway tự set, không cần điền)
# PORT=5031

# JWT Secret — đổi thành chuỗi ngẫu nhiên dài trước khi deploy
JWT_SECRET=artoca_admin_secret_2025

# Cloudinary — để upload ảnh trong admin panel
# Đăng ký miễn phí tại cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
